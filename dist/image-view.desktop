[Desktop Entry]
Name=Image View
GenericName=Image Viewer
Type=Application
Exec=image-view %U
Icon=image-view
StartupNotify=true
StartupWMClass=image-view
Comment=Minimal image viewer
Keywords=photos;pictures;jpeg;png;gif;webp;
Categories=Graphics;Viewer;Photography;
Terminal=false
MimeType=image/bmp;image/x-win-bitmap;image/gif;image/x-icon;image/vnd.microsoft.icon;image/jpeg;image/jpg;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-portable-anymap;image/png;image/apng;image/svg+xml;image/svg+xml-compressed;image/tiff;image/webp;image/x-tga;image/x-exr;image/vnd.radiance;image/qoi;image/x-dds;
